{
  "expo": {
    "name": "AWarden",
    "slug": "awarden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/awarden-mark.png",
    "scheme": "applocker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.applocker.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C1320",
        "foregroundImage": "./assets/images/awarden-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/awarden-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/awarden-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C1320"
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
